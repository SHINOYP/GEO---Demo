# Real-data pilot pipeline (pipeline/) — CSD 415 final review work.
# Copy to a .env at the REPO ROOT (pipeline/common.py loads <repo_root>/.env)
# and fill in real values. Never commit .env.
# (This is separate from the unrelated upstream Getcito .env.example at the
# repo root, which has its own set of variables.)

# Required for pipeline/collect_citations.py
PERPLEXITY_API_KEY=

# Optional for pipeline/collect_candidates.py — if unset, the pipeline
# falls back to search_results embedded in Perplexity responses (narrower
# candidate pool, documented in docs/DATA_CARD.md).
SERPAPI_KEY=
