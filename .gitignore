# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules

# turbo
.turbo
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# tanstack start
.output/
.tanstack/

# production
/build

# misc / secrets
.DS_Store
*.pem
*.key
*.cert
*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug-storybook.log
storybook-static/

# env files (can opt-in for committing if needed)
.env
!.env.example
!.env.whitelabel.example
!.env.local.example

# playwright
playwright-report/
test-results/
blob-report/

# e2e generated config (created by `getcito init --dev --defaults`)
e2e/.getcito/
e2e/.auth/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand kit (generated assets)
getcito-brand-kit.zip
og-default.png

# to remove
prompt_runs.ndjson.gz
prompt_runs_rows.csv
prompt_runs.meta.json

# docker
getcito.yaml
e2e/artifacts

# retroactive cleanup
/features/
.agents/
.cursor/
apps/web/storybook-static/

.claude/settings.local.json
.claude/worktrees/
.readonlydb

# Rebranding
REBRANDING_PLAN.md

# CLI is being ignored for now until it is published
apps/cli/
# transient GitHub Release notes body (scripts/gh-release.mjs)
.release-notes.md

.claude/skills/add-changeset/
docs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
.pytest_cache/
.venv/

# --- Our own work (CSD 415 final review project) ---
# The upstream `docs/` ignore above is for the unrelated Getcito project;
# our own documentation in docs/ must be tracked.
!/docs/
!/docs/**

# Secrets — never commit real API keys
.env
.env.*
!.env.example

# Pipeline-generated data (reproducible from scripts; cached/raw data can be large)
/data/raw/
/data/html_cache/
/demo_cache/

# Evaluation artifacts that are large/binary; metrics.json itself IS tracked
# since the app reads it, but model pickles and figures are regenerable.
/artifacts/*.pkl
/artifacts/figures/
